// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "git": {
    "diff_base": "head"
  },
  "agent_buffer_font_size": 21.0,
  "format_on_save": "on",
  "preferred_line_length": 80,
  "edit_predictions": {
    "allow_data_collection": "no"
  },
  "calls": {
    "mute_on_join": true
  },
  "collaboration_panel": {
    "dock": "right",
    "button": false
  },
  "helix_mode": false,
  "ui_font_weight": 400.0,
  "agent_ui_font_size": 21.0,
  "agent_servers": {
    "codex-acp": {
      "default_config_options": {
        "fast-mode": false,
        "reasoning_effort": "medium",
        "model": "gpt-5.6-terra",
        "mode": "agent-full-access"
      },
      "type": "registry"
    },
  },
  "outline_panel": {
    "dock": "right"
  },
  "git_panel": {
    "show_count_badge": false,
    "entry_primary_click_action": "file_diff",
    "tree_view": false,
    "sort_by": "name",
    "group_by": "staging",
    "dock": "right"
  },
  "project_panel": {
    "dock": "right"
  },
  "icon_theme": {
    "mode": "dark",
    "light": "VSCode Icons for Zed (Light Official Icons)",
    "dark": "Zed (Default)"
  },
  "vim_mode": true,
  "terminal": {
    "font_size": 16.0,
    "font_family": "DankMono-Regular",
    "font_fallbacks": [
      "Menlo",
      "Monaco",
      "Courier New",
      "monospace"
    ]
  },
  "telemetry": {
    "diagnostics": false,
    "metrics": false
  },
  "base_keymap": "VSCode",
  "agent": {
    "flexible": true,
    "experimental_codex_agent_ui": false,
    "sidebar_side": "left",
    "show_turn_stats": true,
    "message_editor_min_lines": 4,
    "thinking_display": "always_collapsed",
    "expand_terminal_card": false,
    "expand_edit_card": false,
    "dock": "left",
    "enabled": true,
    "button": true,
    "model_parameters": []
  },
  "preview_tabs": {
    "enabled": false,
    "enable_preview_from_file_finder": false
  },
  "gutter": {
    "line_numbers": true
  },
  "minimap": {
    "show": "never"
  },
  "cursor_shape": "bar",
  "use_system_window_tabs": true,
  "buffer_font_fallbacks": [
    "Menlo",
    "Monaco",
    "Courier New",
    "monospace"
  ],
  "buffer_font_family": "DankMono-Regular",
  "show_edit_predictions": true,
  "soft_wrap": "editor_width",
  "hard_tabs": true,
  "ui_font_size": 19.0,
  "buffer_font_size": 20.0,
  "theme": {
    "mode": "system",
    "light": "macOS Classic Light",
    "dark": "One Dark"
  },
}
