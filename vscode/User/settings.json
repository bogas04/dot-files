{
  "editor.cursorStyle": "line",
  "editor.defaultFormatter": "esbenp.prettier-vscode",
  "editor.fontFamily": "DankMono-Regular, Menlo, Monaco, 'Courier New', monospace",
  "editor.fontLigatures": true,
  "editor.fontSize": 20,
  "editor.formatOnSave": true,
  "editor.gotoLocation.multipleDeclarations": "goto",
  "editor.gotoLocation.multipleDefinitions": "goto",
  "editor.gotoLocation.multipleImplementations": "goto",
  "editor.gotoLocation.multipleReferences": "goto",
  "editor.gotoLocation.multipleTypeDefinitions": "goto",
  "editor.insertSpaces": false,
  "editor.lineNumbers": "on",
  "editor.minimap.enabled": false,
  "editor.suggest.showStatusBar": true,
  "editor.suggestSelection": "first",
  "editor.wordSeparators": "/\\()\"':,.;<>~!@#$%^&*|+=[]{}`?-",
  "editor.wordWrap": "off",
  "files.exclude": {
    "**/.classpath": true,
    "**/.project": true,
    "**/.settings": true,
    "**/.factorypath": true,
  },
  "git.enableSmartCommit": true,
  "javascript.validate.enable": false,
  "references.preferredLocation": "view",
  "security.workspace.trust.untrustedFiles": "open",
  "terminal.integrated.defaultProfile.windows": "Ubuntu (WSL)",
  "terminal.integrated.fontFamily": "DankMono-Regular, Menlo, Monaco, 'Courier New', monospace",
  "terminal.integrated.fontWeightBold": "normal",
  "typescript.updateImportsOnFileMove.enabled": "always",
  "vim.useSystemClipboard": true,
  "workbench.colorCustomizations": {
    "[GitHub Light]": {
      "terminal.ansiBlack": "#aaaaaa",
      "terminal.ansiBrightBlack": "#aaaaaa",
    },
    "[GitHub Dark Default]": {
      "editor.background": "#000000",
      "sideBar.background": "#000000",
      "terminal.background": "#000000",
      "panel.background": "#000000",
      "tab.inactiveBackground": "#000000",
      "tab.activeBackground": "#333333",
      "statusBar.background": "#000000",
      "sideBar.border": "#000000",
      "diffEditor.removedLineBackground": "#840404",
      "diffEditor.insertedLineBackground": "#094509",
    },
    "[Dark+ Pure Black (OLED)]": {
      "tab.activeBackground": "#000000",
      "tab.inactiveBackground": "#424242",
    },
  },
  "workbench.editor.enablePreview": false,
  "workbench.editor.enablePreviewFromQuickOpen": false,
  "telemetry.telemetryLevel": "off",
  "diffEditor.wordWrap": "off",
  "tsErrorTranslator.showFullTranslation": false,
  "workbench.startupEditor": "none",
  "java.format.settings.url": "https://raw.githubusercontent.com/google/styleguide/gh-pages/eclipse-java-google-style.xml",
  "java.format.settings.profile": "GoogleStyle",
  "java.format.enabled": true,
  "[java]": {
    "editor.defaultFormatter": "redhat.java",
    "editor.formatOnSave": true,
  },
  "java.autobuild.enabled": false,
  "java.implementationsCodeLens.enabled": true,
  "java.configuration.runtimes": [
    {
      "name": "JavaSE-11",
      "path": "/Library/Java/JavaVirtualMachines/zulu-11.jdk/Contents/Home",
    },
  ],
  "java.jdt.ls.java.home": "/Library/Java/JavaVirtualMachines/zulu-11.jdk/Contents/Home",
  "kotlin.languageServer.enabled": false,
  "kotlin.debugAdapter.enabled": false,
  "vim.foldfix": true,
  "explorer.autoRevealExclude": {
    "**/node_modules": false,
  },
  "window.titleBarStyle": "native",
  "editor.inlineSuggest.enabled": true,
  "diffEditor.ignoreTrimWhitespace": false,
  "playwright.reuseBrowser": true,
  "githubPullRequests.terminalLinksHandler": "github",
  "editor.accessibilitySupport": "off",
  "window.commandCenter": false,
  "workbench.layoutControl.enabled": false,
  "workbench.activityBar.location": "top",
  "editor.gotoLocation.alternativeDefinitionCommand": "editor.action.goToImplementation",
  "diffEditor.experimental.showMoves": true,
  "editor.gotoLocation.alternativeTypeDefinitionCommand": "editor.action.goToImplementation",
  "editor.gotoLocation.alternativeDeclarationCommand": "editor.action.goToImplementation",
  "editor.gotoLocation.alternativeReferenceCommand": "editor.action.goToImplementation",
  "editor.gotoLocation.alternativeImplementationCommand": "editor.action.goToImplementation",
  "diffEditor.renderSideBySide": false,
  "window.nativeTabs": true,
  "window.restoreWindows": true,
  "workbench.sideBar.location": "right",
  "chat.commandCenter.enabled": false,
  "window.customTitleBarVisibility": "never",
  "chat.agent.enabled": true,
  "chat.editor.fontSize": 18,
  "terminal.integrated.fontSize": 16,
  "githubPullRequests.pullBranch": "never",
  "cSpell.userWords": [
    "BOTTOMSHEET",
    "creds",
    "FMCG",
    "GSTIN",
    "HEADOUT",
    "kiranas",
    "Pharma",
    "Pressable",
    "Truecaller",
    "udaan",
    "Wondermart",
    "worklets",
  ],
  "github.copilot.enable": {
    "*": true,
    "plaintext": false,
    "markdown": false,
    "scminput": false,
  },
  "chat.fontFamily": "arial",
  "chat.fontSize": 15,
  "github.copilot.nextEditSuggestions.enabled": true,
  "workbench.colorTheme": "Dark Modern",
  "diffEditor.useInlineViewWhenSpaceIsLimited": false,
  "terminal.integrated.initialHint": false,
  "Codegeex.Privacy": false,
  "Codegeex.Chat.LanguagePreference": "English",
  "Codegeex.GenerationPreference": "automatic",
  "Codegeex.SidebarUI.LanguagePreference": "English",
  "Codegeex.Comment.LanguagePreference": "English",
  "Codegeex.CommitMessage.LanguagePreference": "English",
  "workbench.experimental.modernUI": true,
  "git-blame.config.showBlameInline": true,
}
